# Canary — environment variable reference
# Copy relevant variables to your .env or deployment secrets.
# Each token must be a cryptographically random string of at least 64 characters.
# Generate with: bin/console canary:token:generate <scope>
#
# Scopes:
#   monitoring  — health checks and metrics (read-only)
#   cache       — all cache management operations
#   diagnostics — environment info, logs, queue status
#   deploy      — deployment lifecycle endpoints
#   admin       — supertoken, grants access to all scopes

CANARY_TOKEN_MONITORING=
CANARY_TOKEN_CACHE=
CANARY_TOKEN_DIAGNOSTICS=
CANARY_TOKEN_DEPLOY=
CANARY_TOKEN_ADMIN=

# Comma-separated CIDR ranges. Requests from non-matching IPs receive 403.
# Leave empty to skip IP filtering (e.g. shared hosting where IP context is unreliable).
# Example: 127.0.0.1/32,10.0.0.0/8,203.0.113.50/32
CANARY_ALLOWED_CIDRS=

# Requests per minute for read endpoints (health, metrics). Default: 60.
CANARY_RATE_LIMIT_HEALTH=60

# Requests per minute for mutating endpoints (cache, deploy). Default: 10.
CANARY_RATE_LIMIT_MUTATION=10

# Comma-separated feature flags. Disabled endpoint groups return 404.
# Available: health,cache,diagnostics,deploy
# Leave empty to enable all.
CANARY_FEATURES=

# URL prefix for all Canary endpoints. Default: canary → /canary/health/live etc.
# Changing this requires a container cache clear (cache:clear) to take effect.
# Example: CANARY_ROUTE_PREFIX=ops → /ops/health/live
CANARY_ROUTE_PREFIX=canary
