# ─── Docker build ─────────────────────────────────────────────────────────────
PHP_VERSION=8.4

# Set to 'true' to compile xdebug into the PHP image (requires rebuild).
# Use make build-xdebug or docker compose build --build-arg XDEBUG=true php
XDEBUG=false

# ─── Shopware ──────────────────────────────────────────────────────────────────
# Used when building/starting the 'shopware' profile.
# Version constraint passed to: composer create-project shopware/production:${SHOPWARE_VERSION}
SHOPWARE_VERSION=~6.6.0
APP_URL=http://localhost:8080
SHOPWARE_APP_SECRET=change-me-to-a-random-32-char-minimum-secret

# ─── MySQL ─────────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=canary_test
MYSQL_USER=canary
MYSQL_PASSWORD=canary

# ─── Canary tokens ─────────────────────────────────────────────────────────────
# Loaded into the Shopware container via env_file. Also used by integration tests.
# Unit/Functional tests use the values in phpunit.xml instead.
# Minimum 64 characters; generate with: make generate-token SCOPE=monitoring
CANARY_TOKEN_MONITORING=change-me-monitoring-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
CANARY_TOKEN_CACHE=change-me-cache-bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
CANARY_TOKEN_DIAGNOSTICS=change-me-cache-bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
CANARY_TOKEN_ADMIN=change-me-admin-eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee
CANARY_FEATURES=

# ─── Route prefix ──────────────────────────────────────────────────────────────
# URL prefix for all Canary endpoints. Default: canary → /canary/health/live etc.
# Requires cache:clear after any change.
CANARY_ROUTE_PREFIX=canary
